---
import RepositoryRow from "./RepositoryRow.astro";
import type { RepositoryRankingEntry } from "../lib/types";

interface Props {
  caption: string;
  entries: RepositoryRankingEntry[];
  emptyTitle: string;
  emptyMessage: string;
}

const { caption, entries, emptyTitle, emptyMessage } = Astro.props;
---

{
  entries.length > 0 ? (
    <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
      <table class="w-full min-w-[760px] border-collapse">
        <caption class="p-4 text-left text-[1.05rem] font-bold">{caption}</caption>
        <thead>
          <tr>
            <th class="border-t border-slate-200 bg-slate-100 p-3.5 text-left align-top text-xs font-bold uppercase tracking-normal text-slate-700 dark:border-slate-800 dark:bg-slate-800 dark:text-slate-300" scope="col">Rank</th>
            <th class="border-t border-slate-200 bg-slate-100 p-3.5 text-left align-top text-xs font-bold uppercase tracking-normal text-slate-700 dark:border-slate-800 dark:bg-slate-800 dark:text-slate-300" scope="col">Repository</th>
            <th class="border-t border-slate-200 bg-slate-100 p-3.5 text-left align-top text-xs font-bold uppercase tracking-normal text-slate-700 dark:border-slate-800 dark:bg-slate-800 dark:text-slate-300" scope="col">Stars</th>
            <th class="border-t border-slate-200 bg-slate-100 p-3.5 text-left align-top text-xs font-bold uppercase tracking-normal text-slate-700 dark:border-slate-800 dark:bg-slate-800 dark:text-slate-300" scope="col">Language</th>
          </tr>
        </thead>
        <tbody>
          {entries.map((entry) => (
            <RepositoryRow entry={entry} />
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <section class="rounded-lg border border-violet-200 bg-violet-50 p-6 dark:border-violet-800 dark:bg-violet-950" aria-live="polite">
      <h2 class="mb-2 mt-0 text-xl font-bold">{emptyTitle}</h2>
      <p class="m-0 text-slate-500 dark:text-slate-400">{emptyMessage}</p>
    </section>
  )
}
