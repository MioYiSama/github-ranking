---
import { getSnapshotStatus } from "../lib/snapshot";
import type { RankingSnapshot } from "../lib/types";

interface Props {
  snapshot: RankingSnapshot;
}

const { snapshot } = Astro.props;
const status = getSnapshotStatus(snapshot);
---

<aside
  class="flex items-center justify-between gap-4 rounded-lg border border-slate-200 bg-white p-4 data-[state=stale]:border-orange-300 data-[state=stale]:bg-orange-50 data-[state=stale]:text-orange-800 max-[720px]:items-start max-[720px]:flex-col dark:border-slate-800 dark:bg-slate-900 dark:data-[state=stale]:border-orange-700 dark:data-[state=stale]:bg-orange-950 dark:data-[state=stale]:text-orange-200"
  data-snapshot-status
  data-state={status.state}
  aria-label="Ranking data freshness"
>
  <div>
    <strong class="block">{status.label}</strong>
    <span>{status.detail}</span>
  </div>
  <span class="text-sm text-slate-500 dark:text-slate-400">Stale after {new Intl.DateTimeFormat("en-US", { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" }).format(status.staleAfter)} UTC</span>
</aside>
