---
import { formatUtcDateTime } from "../lib/snapshot";
import type { RankingSnapshot } from "../lib/types";

interface Props {
  snapshot: RankingSnapshot;
}

const { snapshot } = Astro.props;
const generatedLabel = formatUtcDateTime(snapshot.generatedAt);
---

<aside
  class="rounded-lg border border-slate-200 bg-white p-4 text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200"
  data-snapshot-status
  aria-label="Ranking data timestamp"
>
  <span>Ranking data fetched at: {generatedLabel}</span>
</aside>
