---
import { getEnabledLanguages } from "../config/languages";
import { withBasePath } from "../lib/paths";

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;
const languages = getEnabledLanguages();
---

<nav class="language-nav" aria-label="Repository ranking languages">
  <a href={withBasePath("/")} aria-current={currentSlug ? undefined : "page"}>Overall</a>
  {
    languages.map((language) => (
      <a href={withBasePath(`/languages/${language.slug}/`)} aria-current={currentSlug === language.slug ? "page" : undefined}>
        {language.displayName}
      </a>
    ))
  }
</nav>
