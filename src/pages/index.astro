---
import VirtualRankingTable from "../components/VirtualRankingTable.astro";
import { snapshotData } from "../data/snapshot";
import BaseLayout from "../layouts/BaseLayout.astro";
import { assertSupportedSnapshot } from "../lib/snapshot";
import type { RankingSnapshot } from "../lib/types";

const snapshot = snapshotData as RankingSnapshot;
assertSupportedSnapshot(snapshot);
---

<BaseLayout
  title="Overall Repository Ranking"
  description=""
  snapshot={snapshot}
>
  <VirtualRankingTable
    caption="Top public repositories overall"
    entries={snapshot.overall}
    emptyTitle="No overall ranking data"
    emptyMessage="The latest successful snapshot did not contain usable overall repository entries."
  />
</BaseLayout>
