{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "tests/visual/**/*-snapshots/**"
  ],
  "rules": {
    "typescript/triple-slash-reference": "off"
  }
}
