{
  "name": "github-ranking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "data:fetch": "node scripts/fetch-rankings.mjs",
    "data:demo": "node scripts/generate-demo-snapshot.mjs",
    "build": "pnpm data:fetch && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:static": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "oxlint . --ignore-pattern '.agents/**' --ignore-pattern '.astro/**' --ignore-pattern '.specify/**' --ignore-pattern 'src/**/*.astro'",
    "lint:fix": "oxlint . --fix --ignore-pattern '.agents/**' --ignore-pattern '.astro/**' --ignore-pattern '.specify/**' --ignore-pattern 'src/**/*.astro'",
    "format": "oxfmt . '!**/.agents/**' '!**/.astro/**' '!**/.specify/**' '!**/node_modules/**' '!**/dist/**' '!**/coverage/**' '!**/playwright-report/**' '!**/test-results/**' '!src/**/*.astro'",
    "format:check": "oxfmt --check . '!**/.agents/**' '!**/.astro/**' '!**/.specify/**' '!**/node_modules/**' '!**/dist/**' '!**/coverage/**' '!**/playwright-report/**' '!**/test-results/**' '!src/**/*.astro'",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build:static && pnpm test:visual"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/virtual-core": "^3.14.0",
    "@types/node": "^25.8.0",
    "ajv": "^8.20.0",
    "astro": "7.0.0-alpha.1",
    "fuse.js": "^7.3.0",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.1.2"
}
